[Unit]
Description=Refresh Cloudflare IP ranges for nginx (cf-nginx)
Documentation=https://github.com/cfunkz/cf-nginx
Wants=network-online.target
After=network-online.target nginx.service

[Service]
Type=oneshot
ExecStart=@SBINDIR@/cf-nginx update --quiet
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=5min
# Hardening: only nginx config, cf-nginx state and (optionally) ufw are writable.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=-/etc/nginx /var/lib/cf-nginx -/etc/cf-nginx /run -/var/log/nginx -/etc/ufw -/lib/ufw -/usr/lib/ufw
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
